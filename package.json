{
  "name": "react-pwa-bun",
  "version": "1.0.0",
  "description": "A single-page PWA built with React and Bun, using localStorage for data persistence",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot todo-app.jsx",
    "build": "bun build todo-app.jsx --outdir ./dist",
    "preview": "bun run dist/index.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0"
  }
}